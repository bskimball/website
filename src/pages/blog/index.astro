---
import BaseHead from '../../components/BaseHead.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getCollection } from 'astro:content'
import { SITE_URL } from '../../consts'
import Search from 'astro-pagefind/components/Search.astro'

import BentoCard from '../../components/BentoCard.astro'
import Backdrop from '../../components/Backdrop.astro'

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const blogDescription =
  'Articles on IBM i modernization, full-stack development, network infrastructure, and systems engineering by Brian Kimball.'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${SITE_URL}/blog/`,
    },
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Blog" description={blogDescription} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </head>
  <body
    class="bg-background text-foreground antialiased selection:bg-primary selection:text-background"
  >
    <div class="noise-overlay"></div>
    <Backdrop />
    <Header />
    <main class="container py-20">
      <section class="flex flex-col gap-12">
        <div class="flex flex-col gap-8">
          <h1
            class="leading-tight text-7xl md:text-8xl font-display animate-in fade-in slide-in-from-bottom-2 fill-mode-both duration-1000"
          >
            Blog
          </h1>

          <div class="blog-search max-w-xl">
            <Search
              className="w-full"
              searchboxOptions={{ placeholder: 'Search posts…' }}
            />
          </div>

          <nav class="flex flex-wrap gap-2" aria-label="Primary topics">
            {
              [
                ['IBM i', 'ibmi'],
                ['Systems architecture', 'systems-architecture'],
                ['AI', 'ai'],
                ['Networking', 'networking'],
                ['Development', 'development'],
              ].map(([label, slug]) => (
                <a
                  href={`/tags/${slug}/`}
                  class="rounded-full border border-border px-3 py-2 font-mono text-[0.7rem] tracking-widest text-foreground/70 no-underline transition-colors hover:border-primary hover:text-primary"
                >
                  {label}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="columns-1 md:columns-2 lg:columns-3 gap-4">
          {posts.map((post) => <BentoCard post={post} class="mb-4" />)}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .blog-search {
    --pf-text: hsl(var(--foreground));
    --pf-text-secondary: hsl(var(--foreground) / 0.7);
    --pf-text-muted: hsl(var(--foreground) / 0.55);
    --pf-background: hsl(var(--card));
    --pf-border: hsl(var(--border));
    --pf-border-focus: hsl(var(--primary));
    --pf-skeleton: hsl(var(--muted));
    --pf-skeleton-shine: hsl(var(--muted));
    --pf-hover: hsl(var(--muted));
    --pf-mark: hsl(var(--primary));
    --pf-scroll-shadow: hsl(var(--foreground) / 0.08);
    --pf-outline-focus: hsl(var(--primary));
    --pf-font: var(--font-sans);
    /* Keep dropdown/result chrome squared; pill only the input below. */
    --pf-border-radius: 0.75rem;
    --pf-searchbox-max-width: 100%;
    --pf-shadow-md: 0 12px 40px hsl(var(--foreground) / 0.12);
    position: relative;
    z-index: 30;
  }

  .blog-search pagefind-searchbox {
    display: block;
    width: 100%;
  }

  .blog-search .pf-searchbox-input {
    border-radius: 9999px;
    border-width: 2px;
    min-height: 2.75rem;
    padding-inline: 1rem 1rem;
    padding-inline-start: 2.5rem;
  }

  .blog-search .pf-searchbox.open .pf-searchbox-input {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .blog-search .pf-searchbox-dropdown {
    border-width: 2px;
    border-top-width: 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: hsl(var(--card));
    overflow: hidden;
  }

  .blog-search .pf-searchbox-result {
    border-radius: 0.5rem;
  }

  .blog-search .pf-searchbox-result[data-pf-selected],
  .blog-search .pf-searchbox-result:hover {
    background: hsl(var(--muted));
  }
</style>
