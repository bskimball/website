---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { Image } from 'astro:assets'
import meImg from '../assets/me_website_2026.png'
import Backdrop from '@/components/Backdrop.astro'
import { SITE_URL, AUTHOR_NAME } from '@/consts'

const aboutDescription =
  'Brian Kimball is a Systems Engineer and Developer based in Delaware. He writes about IBM i modernization, full-stack development, network infrastructure, and building resilient systems from the metal up.'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  url: `${SITE_URL}/about/`,
  image: `${SITE_URL}/static/images/avatar.png`,
  jobTitle: 'Systems Engineer / Developer',
  description: aboutDescription,
  sameAs: ['https://github.com/bskimball'],
  worksFor: {
    '@type': 'Organization',
    name: 'BDK Inc.',
  },
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About',
      item: `${SITE_URL}/about/`,
    },
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About" description={aboutDescription} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </head>
  <body
    class="bg-background text-foreground antialiased selection:bg-primary selection:text-background"
  >
    <div class="noise-overlay"></div>
    <Backdrop />
    <Header />
    <main class="container py-20">
      <div class="flex flex-col gap-12">
        <h1
          class="leading-tight text-7xl md:text-8xl font-display animate-in fade-in slide-in-from-bottom-2 fill-mode-both duration-1000"
        >
          About / Me
        </h1>
        <div
          class="grid lg:grid-cols-5 gap-16 animate-in fade-in slide-in-from-bottom-2 fill-mode-both duration-1000 delay-150"
        >
          <section
            class="col-span-3 prose prose-lg max-w-none text-foreground/80"
          >
            <p>
              I build across the boundary between software and infrastructure.
              My version of "full-stack" includes racking servers, configuring
              VLANs, and <em>then</em> deploying the application.
            </p>
            <p>
              I started in graphic design and web development, moved through
              helpdesk and systems administration, and eventually led the
              technical architecture for a cloud services division. That path
              taught me to treat applications, networks, and hardware as one
              system—not separate specialties.
            </p>

            <h2>Work across the stack</h2>
            <div class="not-prose grid gap-4 sm:grid-cols-2">
              <a
                href="/tags/ibmi/"
                class="rounded-2xl border-2 border-border bg-card p-5 text-foreground no-underline transition-colors hover:border-primary hover:text-primary"
              >
                <h3 class="font-serif text-xl">IBM i modernization</h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground/65">
                  System tooling, application integration, and a practical path
                  forward for the platform.
                </p>
              </a>
              <a
                href="/blog/high-availability/"
                class="rounded-2xl border-2 border-border bg-card p-5 text-foreground no-underline transition-colors hover:border-primary hover:text-primary"
              >
                <h3 class="font-serif text-xl">Infrastructure architecture</h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground/65">
                  Networks, compute, storage, and resilient systems designed as
                  a whole.
                </p>
              </a>
              <a
                href="/blog/building-compass-life-assistant/"
                class="rounded-2xl border-2 border-border bg-card p-5 text-foreground no-underline transition-colors hover:border-primary hover:text-primary"
              >
                <h3 class="font-serif text-xl">Application development</h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground/65">
                  Full-stack products built for low operational complexity and
                  graceful failure.
                </p>
              </a>
              <a
                href="/blog/custom-pi-agent-workflow/"
                class="rounded-2xl border-2 border-border bg-card p-5 text-foreground no-underline transition-colors hover:border-primary hover:text-primary"
              >
                <h3 class="font-serif text-xl">Engineering tools and AI</h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground/65">
                  Agent workflows and tools that make technical teams more
                  capable without hiding the process.
                </p>
              </a>
            </div>

            <p>
              This site is a working catalog of my open-source contributions,
              production lessons, and technical experiments. I am based in
              Delaware, where I balance engineering with life as a husband and
              father of three—and an unreasonable amount of Baltimore sports and
              Star Wars.
            </p>

            <div
              class="not-prose mt-10 rounded-2xl border-2 border-primary/30 bg-card p-6"
            >
              <h2 class="font-serif text-2xl text-foreground">
                Have a systems-heavy problem?
              </h2>
              <p class="mt-2 leading-relaxed text-foreground/65">
                I am always glad to discuss IBM i modernization, infrastructure
                architecture, or software that has to survive real operations.
              </p>
              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href="mailto:hello@brian-kimball.com"
                  class="rounded-full border-2 border-primary bg-primary px-5 py-3 font-mono text-xs tracking-widest text-primary-foreground no-underline hover:bg-transparent hover:text-primary"
                  >Email Brian</a
                >
                <a
                  href="https://www.linkedin.com/in/brian-kimball-0499678a/"
                  target="_blank"
                  rel="noreferrer"
                  class="rounded-full border-2 border-border px-5 py-3 font-mono text-xs tracking-widest text-foreground no-underline hover:border-primary hover:text-primary"
                  >LinkedIn</a
                >
              </div>
            </div>
          </section>
          <aside
            class="col-span-2 flex flex-col items-center lg:items-end gap-8"
          >
            <div
              class="transition-all duration-500 border-2 border-border p-2 bg-card rounded-full"
            >
              <Image
                src={meImg}
                alt="Brian Kimball portrait"
                class="w-64 h-auto aspect-square object-cover rounded-full"
                quality="max"
                format="png"
                widths={[256, 512, 1024]}
                sizes="256px"
              />
            </div>
            <div class="font-mono text-sm tracking-widest text-primary">
              Systems Engineer / Developer
            </div>
          </aside>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
