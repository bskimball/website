---
// Star topology of the Pi session: one lead agent, three dispatch paths.
// Two hand-tuned layouts (wide + stacked) so the mono labels stay legible
// instead of shrinking into unreadability on narrow screens.
const description =
  'Star topology. A single Pi session lead agent dispatches three ways: to a synchronous task in a fresh child process, which returns a specialist final report; to an asynchronous RPC worker backed by a persistent specialist; and to local tools for web, MCP, background processes, and the terminal UI. Workers never spawn workers.'
---

<figure class="not-prose my-10">
  <div
    class="overflow-hidden rounded-2xl border-2 border-border bg-card/60 p-4 sm:p-6"
  >
    <!-- Wide layout -->
    <svg
      class="hidden h-auto w-full md:block"
      viewBox="0 0 720 352"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="pi-topology-title pi-topology-desc"
    >
      <title id="pi-topology-title">Pi agent star topology</title>
      <desc id="pi-topology-desc">{description}</desc>

      <defs>
        <pattern
          id="pi-topology-grid"
          width="24"
          height="24"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M24 0H0V24"
            fill="none"
            class="stroke-border"
            stroke-width="1"
            opacity="0.4"></path>
        </pattern>
      </defs>
      <rect width="720" height="352" fill="url(#pi-topology-grid)"></rect>

      <!-- restrained atomic ornament -->
      <g class="fill-gold" opacity="0.6" transform="translate(676 316)">
        <path d="M0,-18 L4,-4 L18,0 L4,4 L0,18 L-4,4 L-18,0 L-4,-4 Z"></path>
        <circle cx="0" cy="0" r="2.5"></circle>
      </g>

      <!-- bus: lead -> three branches -->
      <g class="stroke-primary fill-primary" stroke-width="2">
        <path d="M360 84 V120 M120 120 H600" fill="none" stroke-linecap="round"
        ></path>
      </g>
      <g class="stroke-gold fill-gold" stroke-width="2">
        <path d="M120 120 V147" fill="none"></path>
        <polygon points="120,156 115,146 125,146" stroke="none"></polygon>
        <path d="M120 232 V259" fill="none"></path>
        <polygon points="120,268 115,258 125,258" stroke="none"></polygon>
      </g>
      <g class="stroke-accent fill-accent" stroke-width="2">
        <path d="M360 120 V147" fill="none"></path>
        <polygon points="360,156 355,146 365,146" stroke="none"></polygon>
        <path d="M360 232 V259" fill="none"></path>
        <polygon points="360,268 355,258 365,258" stroke="none"></polygon>
      </g>
      <g class="stroke-border fill-border" stroke-width="2">
        <path d="M600 120 V147" fill="none"></path>
        <polygon points="600,156 595,146 605,146" stroke="none"></polygon>
      </g>

      <!-- lead -->
      <rect
        x="260"
        y="20"
        width="200"
        height="64"
        rx="14"
        stroke-width="2"
        class="fill-primary/10 stroke-primary"></rect>
      <text
        x="360"
        y="46"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">Pi session</text
      >
      <text
        x="360"
        y="66"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">lead agent</text
      >

      <!-- sync branch -->
      <rect
        x="20"
        y="156"
        width="200"
        height="76"
        rx="14"
        stroke-width="2"
        class="fill-gold/10 stroke-gold"></rect>
      <text
        x="120"
        y="188"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">sync task</text
      >
      <text
        x="120"
        y="208"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">fresh child</text
      >
      <rect
        x="20"
        y="268"
        width="200"
        height="68"
        rx="14"
        stroke-width="2"
        class="fill-gold/10 stroke-gold"></rect>
      <text
        x="120"
        y="296"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">specialist</text
      >
      <text
        x="120"
        y="316"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">final report</text
      >

      <!-- async branch -->
      <rect
        x="260"
        y="156"
        width="200"
        height="76"
        rx="14"
        stroke-width="2"
        class="fill-accent/10 stroke-accent"></rect>
      <text
        x="360"
        y="188"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">async RPC</text
      >
      <text
        x="360"
        y="208"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">worker</text
      >
      <rect
        x="260"
        y="268"
        width="200"
        height="68"
        rx="14"
        stroke-width="2"
        class="fill-accent/10 stroke-accent"></rect>
      <text
        x="360"
        y="296"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">persistent</text
      >
      <text
        x="360"
        y="316"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">specialist</text
      >

      <!-- local tools -->
      <rect
        x="500"
        y="156"
        width="200"
        height="76"
        rx="14"
        stroke-width="2"
        class="fill-muted/50 stroke-border"></rect>
      <text
        x="600"
        y="182"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="15"
        font-weight="700">local tools</text
      >
      <text
        x="600"
        y="202"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">web / MCP</text
      >
      <text
        x="600"
        y="220"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="13">bg / UI</text
      >
    </svg>

    <!-- Stacked layout -->
    <svg
      class="mx-auto block h-auto w-full max-w-[340px] md:hidden"
      viewBox="0 0 320 508"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="pi-topology-title-sm pi-topology-desc-sm"
    >
      <title id="pi-topology-title-sm">Pi agent star topology</title>
      <desc id="pi-topology-desc-sm">{description}</desc>

      <rect width="320" height="508" fill="url(#pi-topology-grid-sm)"></rect>
      <defs>
        <pattern
          id="pi-topology-grid-sm"
          width="24"
          height="24"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M24 0H0V24"
            fill="none"
            class="stroke-border"
            stroke-width="1"
            opacity="0.4"></path>
        </pattern>
      </defs>

      <g class="fill-gold" opacity="0.6" transform="translate(290 492)">
        <path d="M0,-13 L3,-3 L13,0 L3,3 L0,13 L-3,3 L-13,0 L-3,-3 Z"></path>
      </g>

      <!-- rail -->
      <path
        d="M160 68 V84 H24 V448"
        fill="none"
        class="stroke-primary"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>

      <rect
        x="40"
        y="8"
        width="240"
        height="60"
        rx="14"
        stroke-width="2"
        class="fill-primary/10 stroke-primary"></rect>
      <text
        x="160"
        y="34"
        text-anchor="middle"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">Pi session</text
      >
      <text
        x="160"
        y="54"
        text-anchor="middle"
        class="fill-muted-foreground font-mono"
        font-size="12.5">lead agent</text
      >

      <!-- sync -->
      <g class="stroke-gold fill-gold" stroke-width="2">
        <path d="M24 116 H51" fill="none"></path>
        <polygon points="60,116 50,111 50,121" stroke="none"></polygon>
        <path d="M184 144 V171" fill="none"></path>
        <polygon points="184,180 179,170 189,170" stroke="none"></polygon>
      </g>
      <rect
        x="60"
        y="88"
        width="248"
        height="56"
        rx="14"
        stroke-width="2"
        class="fill-gold/10 stroke-gold"></rect>
      <text
        x="76"
        y="112"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">sync task</text
      >
      <text
        x="76"
        y="130"
        class="fill-muted-foreground font-mono"
        font-size="12.5">fresh child</text
      >
      <rect
        x="60"
        y="180"
        width="248"
        height="56"
        rx="14"
        stroke-width="2"
        class="fill-gold/10 stroke-gold"></rect>
      <text
        x="76"
        y="204"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">specialist</text
      >
      <text
        x="76"
        y="222"
        class="fill-muted-foreground font-mono"
        font-size="12.5">final report</text
      >

      <!-- async -->
      <g class="stroke-accent fill-accent" stroke-width="2">
        <path d="M24 280 H51" fill="none"></path>
        <polygon points="60,280 50,275 50,285" stroke="none"></polygon>
        <path d="M184 308 V335" fill="none"></path>
        <polygon points="184,344 179,334 189,334" stroke="none"></polygon>
      </g>
      <rect
        x="60"
        y="252"
        width="248"
        height="56"
        rx="14"
        stroke-width="2"
        class="fill-accent/10 stroke-accent"></rect>
      <text
        x="76"
        y="276"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">async RPC</text
      >
      <text
        x="76"
        y="294"
        class="fill-muted-foreground font-mono"
        font-size="12.5">worker</text
      >
      <rect
        x="60"
        y="344"
        width="248"
        height="56"
        rx="14"
        stroke-width="2"
        class="fill-accent/10 stroke-accent"></rect>
      <text
        x="76"
        y="368"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">persistent</text
      >
      <text
        x="76"
        y="386"
        class="fill-muted-foreground font-mono"
        font-size="12.5">specialist</text
      >

      <!-- local tools -->
      <g class="stroke-border fill-border" stroke-width="2">
        <path d="M24 448 H51" fill="none"></path>
        <polygon points="60,448 50,443 50,453" stroke="none"></polygon>
      </g>
      <rect
        x="60"
        y="420"
        width="248"
        height="56"
        rx="14"
        stroke-width="2"
        class="fill-muted/50 stroke-border"></rect>
      <text
        x="76"
        y="444"
        class="fill-foreground font-mono"
        font-size="14"
        font-weight="700">local tools</text
      >
      <text
        x="76"
        y="462"
        class="fill-muted-foreground font-mono"
        font-size="12.5">web / MCP / bg / UI</text
      >
    </svg>
  </div>
  <figcaption class="mt-3 font-mono text-xs text-muted-foreground">
    One coordinator, three dispatch paths. Workers never spawn workers.
  </figcaption>
</figure>
